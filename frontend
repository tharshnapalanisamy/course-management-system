<!DOCTYPE html>
<html>
<head>
    <title>Course Management System</title>

    <style>
        body {
            margin: 0;
            font-family: Arial;
            background: #f1f5f9;
        }

        header {
            background: #1e3a8a;
            color: white;
            padding: 25px;
            text-align: center;
        }

        .container {
            width: 90%;
            margin: 25px auto;
        }

        .cards {
            display: flex;
            gap: 20px;
            margin-bottom: 25px;
        }

        .card {
            flex: 1;
            color: white;
            padding: 25px;
            border-radius: 12px;
            text-align: center;
        }

        .blue {
            background: #2563eb;
        }

        .green {
            background: #16a34a;
        }

        .orange {
            background: #ea580c;
        }

        .card h2 {
            font-size: 35px;
        }

        .box {
            background: white;
            padding: 25px;
            margin-bottom: 25px;
            border-radius: 12px;
            box-shadow: 0 3px 10px #ccc;
        }

        h2 {
            color: #1e3a8a;
        }

        input,
        select {
            width: 95%;
            padding: 12px;
            margin: 8px 0;
            border: 1px solid #ccc;
            border-radius: 6px;
        }

        button {
            background: #2563eb;
            color: white;
            border: none;
            padding: 12px 20px;
            border-radius: 6px;
            cursor: pointer;
        }

        button:hover {
            background: #1e3a8a;
        }

        table {
            width: 100%;
            border-collapse: collapse;
        }

        th,
        td {
            padding: 12px;
            border: 1px solid #ddd;
            text-align: center;
        }

        th {
            background: #1e3a8a;
            color: white;
        }

        tr:nth-child(even) {
            background: #eff6ff;
        }

        @media(max-width: 700px) {
            .cards {
                flex-direction: column;
            }
        }
    </style>
</head>

<body>

<header>
    <h1>Course Management System</h1>
    <p>Manage Courses Easily</p>
</header>

<div class="container">

    <div class="cards">

        <div class="card blue">
            <p>Total Courses</p>
            <h2 id="total">0</h2>
        </div>

        <div class="card green">
            <p>Active Courses</p>
            <h2 id="active">0</h2>
        </div>

        <div class="card orange">
            <p>Inactive Courses</p>
            <h2 id="inactive">0</h2>
        </div>

    </div>

    <div class="box">

        <h2>Add Course</h2>

        <form id="courseForm">

            <input type="text" id="name"
                   placeholder="Course Name" required>

            <input type="text" id="code"
                   placeholder="Course Code" required>

            <input type="text" id="instructor"
                   placeholder="Instructor Name" required>

            <input type="text" id="duration"
                   placeholder="Duration" required>

            <input type="number" id="credits"
                   placeholder="Credits" required>

            <select id="status" required>
                <option value="">Select Status</option>
                <option value="Active">Active</option>
                <option value="Inactive">Inactive</option>
            </select>

            <br><br>

            <button type="submit">Add Course</button>

        </form>

    </div>

    <div class="box">

        <h2>Course List</h2>

        <input type="text"
               id="search"
               placeholder="Search course..."
               onkeyup="displayCourses()">

        <table>
            <thead>
                <tr>
                    <th>S.No</th>
                    <th>Name</th>
                    <th>Code</th>
                    <th>Instructor</th>
                    <th>Duration</th>
                    <th>Credits</th>
                    <th>Status</th>
                </tr>
            </thead>

            <tbody id="courseTable"></tbody>
        </table>

    </div>

</div>

<script>
    let courses = [];

    document.getElementById("courseForm")
        .addEventListener("submit", function(event) {

        event.preventDefault();

        const course = {
            name: document.getElementById("name").value,
            code: document.getElementById("code").value,
            instructor: document.getElementById("instructor").value,
            duration: document.getElementById("duration").value,
            credits: document.getElementById("credits").value,
            status: document.getElementById("status").value
        };

        courses.push(course);

        displayCourses();

        document.getElementById("courseForm").reset();
    });

    function displayCourses() {

        const table = document.getElementById("courseTable");
        const searchText = document.getElementById("search")
            .value.toLowerCase();

        table.innerHTML = "";

        let filteredCourses = courses.filter(function(course) {
            return course.name.toLowerCase().includes(searchText) ||
                   course.code.toLowerCase().includes(searchText);
        });

        filteredCourses.forEach(function(course, index) {

            table.innerHTML += `
                <tr>
                    <td>${index + 1}</td>
                    <td>${course.name}</td>
                    <td>${course.code}</td>
                    <td>${course.instructor}</td>
                    <td>${course.duration}</td>
                    <td>${course.credits}</td>
                    <td>${course.status}</td>
                </tr>
            `;
        });

        document.getElementById("total").innerText =
            courses.length;

        document.getElementById("active").innerText =
            courses.filter(c => c.status === "Active").length;

        document.getElementById("inactive").innerText =
            courses.filter(c => c.status === "Inactive").length;
    }
</script>

</body>
</html>
