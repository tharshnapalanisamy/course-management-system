import com.sun.net.httpserver.HttpServer;
import com.sun.net.httpserver.HttpExchange;
import com.sun.net.httpserver.HttpHandler;

import java.io.IOException;
import java.io.OutputStream;
import java.net.InetSocketAddress;

public class CourseServer {

    public static void main(String[] args) throws IOException {

        HttpServer server = HttpServer.create(
                new InetSocketAddress(5000), 0
        );

        server.createContext("/", new CourseHandler());

        server.setExecutor(null);

        System.out.println(
                "Course Backend Server running at http://localhost:5000"
        );

        server.start();
    }

    static class CourseHandler implements HttpHandler {

        @Override
        public void handle(HttpExchange exchange)
                throws IOException {

            String response =
                    "Course Management Backend is Running";

            exchange.sendResponseHeaders(
                    200,
                    response.length()
            );

            OutputStream output =
                    exchange.getResponseBody();

            output.write(response.getBytes());
            output.close();
        }
    }
}
